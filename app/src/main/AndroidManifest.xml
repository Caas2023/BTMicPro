<?xml version="1.0" encoding="utf-8"?>
<!-- Manifesto da aplicação BT Mic Pro -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissão para captura de áudio -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Permissões de Bluetooth -->
    <!-- Android 12 (API 31) ou superior -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11 (API 30) ou inferior -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Permissão para modificar configurações de áudio (SCO, volume, etc.) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Permissões para Serviços em Primeiro Plano (Foreground Services) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Permissão para envio de notificações (Android 13+ / API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permissão para inicialização automática após boot do sistema -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Permissão de gravação no armazenamento legado (Android 9 ou inferior) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".BtMicProApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        tools:targetApi="35">

        <!-- Activity Principal (Compose / Ponto de Entrada) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serviço de Roteamento de Microfone Bluetooth (Modo Router) -->
        <service
            android:name=".service.BtMicService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Serviço de Gravação com IA / DSP (Modo Gravador) -->
        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Broadcast Receiver para Inicialização Automática após Boot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider para compartilhamento direto de áudios com o WhatsApp -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
